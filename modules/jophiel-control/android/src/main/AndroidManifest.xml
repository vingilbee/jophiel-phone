<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Phase 9, phone control: she reads the screen and taps, types, scrolls and presses back / home,
      only while you're talking with her, with a banner up whose Stop stops her. Android binds
      it once you turn Jophiel on in Settings → Accessibility (after "Allow restricted settings").
    -->
    <service
      android:name="expo.modules.jophielcontrol.JophielControlService"
      android:label="@string/jophiel_control_label"
      android:exported="true"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/jophiel_control_service" />
    </service>
  </application>
</manifest>
